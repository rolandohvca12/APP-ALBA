{
  "name": "etabsjs",
  "version": "0.1.0",
  "description": "Strongly typed TypeScript and JavaScript API for CSI ETABS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "host"
  ],
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-package.ps1",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "etabs",
    "structural-engineering",
    "finite-element-analysis",
    "typescript",
    "javascript"
  ],
  "author": "Rolando Auqui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolandohvca12/APP-ALBA.git",
    "directory": "bridges/ETABS.Client"
  },
  "homepage": "https://github.com/rolandohvca12/APP-ALBA/tree/main/bridges/ETABS.Client",
  "bugs": {
    "url": "https://github.com/rolandohvca12/APP-ALBA/issues"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  }
}
