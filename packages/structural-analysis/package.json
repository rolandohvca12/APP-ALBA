{
  "name": "@app-alba/structural-analysis",
  "version": "0.1.0",
  "description": "Solver-neutral equivalent-wide-column structural analysis for APP-ALBA.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs tests/integration/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@app-alba/autocad-client": "0.1.0",
    "@app-alba/etabs-bridge-client": "0.1.0",
    "@app-alba/engineering-units": "0.1.0",
    "@app-alba/peru-rne": "0.1.0",
    "openseesjs": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  }
}
